# Server-side runtime config — contains live secrets (SenseStudio password,
# live-stream token, LLM API keys) and per-deployment overrides. Edited from
# the dashboard's Settings/Alert Rules pages, not meant to be versioned.
storage/app_settings.json
storage/alert_settings.json
storage/roles.json
storage/sense_token.json
storage/upstream_state.json
storage/forecast_llm.json
storage/mail_*.lock
storage/attachments/
storage/kiosk/
storage/live_bridge.json
storage/live_snap/

# Employee/operator-uploaded profile photos — privacy, not source.
uploads/profiles/

# Vendor documentation bundle (large, not project source).
sensetimedocumentation/
docs/fwdsensetimedocumentation/

# Runtime caches / cursors written by the dashboard.
storage/overview_*.json
storage/*_cursor.json

cp_src/
.playwright-mcp/
*.png
!uploads/*.png
.DS_Store
# Scoring-matrix modules: runtime state, secrets and logs
storage/notify_settings.json
storage/notify_log.json
