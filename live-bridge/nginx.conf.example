# Kian Joo VisionAI — live bridge behind nginx (alternative to the Caddyfile).
#
# Same behaviour as the Caddyfile: allow when ?token= or the lt cookie equals
# the bridge token, set the lt cookie on a token request (for go2rtc's
# stream.html pop-out and its /api/ws socket), CORS "*", 403 otherwise.
#
# nginx cannot read environment variables here, so replace every
# 0123456789abcdef0123456789abcdef0123456789abcdef below with your real
# LIVE_TOKEN (openssl rand -hex 24), and live.example.com with your domain.
# go2rtc is expected on 127.0.0.1:1984 (the compose file's port mapping, or a
# native install). The map blocks belong in the http {} context.

map "$arg_token:$cookie_lt" $lt_ok {
    default 0;
    "~^0123456789abcdef0123456789abcdef0123456789abcdef:" 1;   # query token
    "~:0123456789abcdef0123456789abcdef0123456789abcdef$" 1;   # lt cookie
}

map $arg_token $lt_setcookie {
    default "";
    "0123456789abcdef0123456789abcdef0123456789abcdef" "lt=0123456789abcdef0123456789abcdef0123456789abcdef; Path=/; Secure; HttpOnly; SameSite=None";
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    ""      close;
}

server {
    listen 80;
    server_name live.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name live.example.com;

    # e.g. issued with: certbot --nginx -d live.example.com
    ssl_certificate     /etc/letsencrypt/live/live.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/live.example.com/privkey.pem;

    location / {
        if ($request_method = OPTIONS) {
            add_header Access-Control-Allow-Origin  "*";
            add_header Access-Control-Allow-Methods "GET, PUT, DELETE, OPTIONS";
            add_header Access-Control-Allow-Headers "Authorization, Content-Type";
            return 204;
        }
        if ($lt_ok = 0) {
            return 403;
        }

        # An empty value (request without ?token=) makes nginx omit the header.
        add_header Set-Cookie $lt_setcookie always;
        proxy_hide_header Access-Control-Allow-Origin;
        add_header Access-Control-Allow-Origin "*" always;

        proxy_pass http://127.0.0.1:1984;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade $http_upgrade;            # /api/ws (stream.html)
        proxy_set_header Connection $connection_upgrade;
        proxy_buffering off;                                # live fragmented MP4
        proxy_read_timeout 1h;
    }
}
