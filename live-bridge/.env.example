# Kian Joo VisionAI — live bridge (go2rtc + Caddy) environment
# Copy to .env next to docker-compose.yml. Never commit .env.

# Public HTTPS name of this bridge. DNS A/AAAA must point at this host and
# ports 80/443 must be reachable so Caddy can obtain a Let's Encrypt cert.
LIVE_DOMAIN=live.example.com

# Shared secret the dashboard appends as ?token=… (Settings › Live Video ›
# TOKEN, or LIVE_STREAM_TOKEN in the dashboard .env). Generate one with:
#   openssl rand -hex 24
# Required — docker compose refuses to start Caddy without it.
LIVE_TOKEN=
