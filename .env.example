# ============================================================
#  tm-next-series.weststar-dev.com — environment (template)
#  Copy to .env and fill in real values. Never commit .env.
# ============================================================

# ── Deploy (LFTP / FTP) ─────────────────────────────────────
FTP_HOST=
FTP_PORT=21
FTP_USER=
FTP_PASS=
FTP_SECURE=true
FTP_REMOTE_DIR=/public_html/tm-next-series.weststar-dev.com

# ── App ─────────────────────────────────────────────────────
APP_ENV=production
APP_DEBUG=false
APP_TZ=Asia/Kuala_Lumpur
APP_NAME="TM Next Series — SenseTime Ingest"

# ── Ingest API ──────────────────────────────────────────────
INGEST_TOKEN=change-me-long-random
READ_TOKEN=change-me-long-random
PROVISION_TOKEN=change-me

# ── Storage (MySQL) ─────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_PATH=storage/events.sqlite
RAW_LOG=storage/events.jsonl
MAX_EVENTS=0

# ── Image host ──────────────────────────────────────────────
SENSE_IMAGE_BASE=https://sensestudio.ngrok.io/intersense

# ── SMTP notifications ──────────────────────────────────────
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="TM Next Series Monitoring"
MAIL_TO=
MAIL_COOLDOWN_MIN=5

# ── Alert rules ─────────────────────────────────────────────
# Minimum severity that emails: low|medium|high|critical|off.
ALERT_MIN_SEVERITY=high
# Modules that always email regardless of severity (fire,ppe,intr,face).
ALERT_ALWAYS_MODS=fire
# Intrusion armed window: emails fire only inside it. "always", "off",
# or a range like 22:00-06:00 (overnight spans OK).
INTRUSION_ARMED=always

# ── Weststar AI middleware (LLM review + analytics) ─────────
WESTAR_AI_BASE=https://api.weststar-ai.com/sensetime
FORWARD_WESTAR_AI=true

# ── Optional forward ────────────────────────────────────────
FORWARD_FIREBASE_BASE=
