# ============================================================
#  Kian Joo VisionAI — environment (template)
#  Copy to .env and fill in real values. Never commit .env.
# ============================================================

# ── App ─────────────────────────────────────────────────────
APP_ENV=production
APP_DEBUG=false
APP_TZ=Asia/Kuala_Lumpur
APP_NAME="Kian Joo VisionAI"
# Public base URL (no trailing slash) — used in email links and as the SMTP
# EHLO/Message-ID domain when there's no HTTP request context (cron). Leave
# blank to auto-detect from the request host; set it explicitly for cron/CLI.
APP_URL=https://kianjoo.weststar-dev.com
# Password for the auto-seeded "admin" account on a brand-new database.
# Set a real one here before first login — change it in Users & Roles after.
ADMIN_SEED_PASSWORD=change-me-strong

# ── Deploy (LFTP / FTP) — only needed if NOT deploying via cPanel Git ──
FTP_HOST=
FTP_PORT=21
FTP_USER=
FTP_PASS=
FTP_SECURE=true
FTP_REMOTE_DIR=

# ── Ingest API ──────────────────────────────────────────────
INGEST_TOKEN=change-me-long-random
READ_TOKEN=change-me-long-random
PROVISION_TOKEN=change-me

# ── Auto-deploy webhook (deploy.php) ─────────────────────────
# Generate on the SERVER, never commit it: openssl rand -hex 24
# Same value goes into the GitHub webhook's "Secret" field.
DEPLOY_TOKEN=

# ── Storage (MySQL) ─────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_PATH=storage/events.sqlite
RAW_LOG=storage/events.jsonl
MAX_EVENTS=0

# ── Image host ──────────────────────────────────────────────
# Leave the SenseStudio/VisionAI fields blank until the POC vendor endpoint is
# confirmed — they can also be set later from the dashboard's Settings page.
SENSE_IMAGE_BASE=
SENSE_API_BASE=
SENSE_API_ACCOUNT=
SENSE_API_PASSWORD=

# ── Live video (RTSP → browser bridge) ──────────────────────
# Browsers can't play RTSP: a go2rtc bridge (see live-bridge/README.md)
# re-serves each camera as MP4. Leave LIVE_STREAM_BASE blank to show the
# latest detection frame on the tiles instead. All of these can also be set
# from the dashboard's Settings › Live Video tab (which overrides .env).
# Public HTTPS base the BROWSER loads, no trailing slash
# (tiles play {base}/api/stream.mp4?src={stream}&token=…).
LIVE_STREAM_BASE=
# Bridge token (live-bridge/.env LIVE_TOKEN), appended as ?token= on browser
# and server calls. Blank only if the bridge is not gated.
LIVE_STREAM_TOKEN=
# Optional internal URL for server→bridge API calls, e.g. http://127.0.0.1:1984
# when the dashboard runs on the bridge host. Blank = use LIVE_STREAM_BASE.
LIVE_BRIDGE_API=
# Optional go2rtc api.username / api.password (server→bridge calls only;
# browsers can't send basic auth on <video>, so keep the token proxy too).
LIVE_BRIDGE_USER=
LIVE_BRIDGE_PASS=
# Register every SenseStudio camera's RTSP URL on the bridge automatically
# (at most every 5 min on fleet refresh, and on camera add/edit).
LIVE_AUTO_SYNC=true
# Manual sources for cameras outside SenseStudio, JSON {"label":"rtsp-url"};
# labels are lower-cased a-z0-9 and override a fleet camera with the same
# label. Example: {"line5":"rtsp://user:pass@192.168.1.10:554/Streaming/Channels/102"}
RTSP_STREAMS={}

# ── SMTP notifications ──────────────────────────────────────
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Kian Joo VisionAI Monitoring"
MAIL_TO=
MAIL_COOLDOWN_MIN=5

# ── Alert rules ─────────────────────────────────────────────
# Minimum severity that emails: low|medium|high|critical|off.
ALERT_MIN_SEVERITY=high
# Modules that always email regardless of severity (fire,ppe,intr,face).
ALERT_ALWAYS_MODS=fire
# Intrusion armed window: emails fire only inside it. "always", "off",
# or a range like 22:00-06:00 (overnight spans OK).
INTRUSION_ARMED=always

# ── Weststar AI middleware (LLM review + analytics) — optional ─────
WESTAR_AI_BASE=https://api.weststar-ai.com/sensetime
FORWARD_WESTAR_AI=false
WESTAR_AI_KEY=

# ── Optional forward ────────────────────────────────────────
FORWARD_FIREBASE_BASE=
